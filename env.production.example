# ===========================================
# MAGATHI FRONTEND - PRODUCTION ENVIRONMENT
# ===========================================

# API Configuration
VITE_API_URL=https://api.magathi.com
VITE_APP_ENV=production

# Firebase Configuration (if using)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=magathi.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=magathi-project
VITE_FIREBASE_STORAGE_BUCKET=magathi.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Security Configuration
VITE_ENABLE_HTTPS=true
VITE_CSP_ENABLED=true

# Analytics Configuration
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_SENTRY_DSN=your_sentry_dsn_here

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
